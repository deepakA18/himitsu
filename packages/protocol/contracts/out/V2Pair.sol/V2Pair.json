he TWAP price accumulators, protocol fee (feeTo), skim/sync, and LP-token transfers.\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"constructor\":{\"notice\":\"Tokens are sorted by address, as the factory does.\"},\"mint(address)\":{\"notice\":\"Liquidity is minted against tokens already sent to the pair.\"},\"swap(uint256,uint256,address,bytes)\":{\"notice\":\"Send the output, then require the invariant to still hold. The caller is expected to have transferred the input in first -- in this demo, by an earlier frame of the same transaction.\"}},\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/V2Pair.sol\":\"V2Pair\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"src/V2Pair.sol\":{\"keccak256\":\"0xdbe774795404c752f90f4d0bf7fe89246fdce0be682bc77d397a1356e91b3484\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://9573456c45665674d8db35e0763dd40a2c2e7a9de18b7c59594a46af8985a395\",\"dweb:/ipfs/QmRAwpRBuk114kd8QCgWdmVTjV4ChoT4tX1yGyJhVMrFkZ\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.30+commit.73712a01"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"address","name":"tokenA","type":"address"},{"internalType":"address","name":"tokenB","type":"address"}],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[{"internalType":"address","name":"sender","type":"address","indexed":true},{"internalType":"uint256","name":"amount0","type":"uint256","indexed":false},{"internalType":"uint256","name":"amount1","type":"uint256","indexed":false}],"type":"event","name":"Mint","anonymous":false},{"inputs":[{"internalType":"address","name":"sender","type":"address","indexed":true},{"internalType":"uint256","name":"amount0In","type":"uint256","indexed":false},{"internalType":"uint256","name":"amount1In","type":"uint256","indexed":false},{"internalType":"uint256","name":"amount0Out","type":"uint256","indexed":fa