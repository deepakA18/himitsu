6;140;193:3;181:9;172:7;168:23;164:33;161:53;;;210:1;207;200:12;161:53;248:3;237:9;233:19;271:7;267:2;264:15;261:35;;;292:1;289;282:12;261:35;315:9;305:19;;360:7;354:3;343:9;339:19;336:32;333:52;;;381:1;378;371:12;333:52;404:2;394:12;;;14:398;;;;;:::o;741:209::-;773:1;799;789:132;;843:10;838:3;834:20;831:1;824:31;878:4;875:1;868:15;906:4;903:1;896:15;789:132;-1:-1:-1;935:9:2;;741:209::o;955:225::-;1022:9;;;1043:11;;;1040:134;;;1096:10;1091:3;1087:20;1084:1;1077:31;1131:4;1128:1;1121:15;1159:4;1156:1;1149:15","linkReferences":{},"immutableReferences":{"12":[{"start":620,"length":32}],"14":[{"start":662,"length":32}],"16":[{"start":704,"length":32}],"18":[{"start":743,"length":32}],"20":[{"start":782,"length":32}],"22":[{"start":821,"length":32}],"24":[{"start":876,"length":32}],"26":[{"start":915,"length":32}],"28":[{"start":954,"length":32}],"30":[{"start":993,"length":32}],"32":[{"start":1051,"length":32}],"34":[{"start":1090,"length":32}],"36":[{"start":1129,"length":32}],"38":[{"start":1168,"length":32}],"40":[{"start":183,"length":32}],"42":[{"start":216,"length":32}],"44":[{"start":254,"length":32}],"46":[{"start":287,"length":32}],"48":[{"start":359,"length":32}],"50":[{"start":392,"length":32}]}},"methodIdentifiers":{"verify(uint256[8],uint256[2])":"f4fd6a1f"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.30+commit.73712a01\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"uint256[20]\",\"name\":\"vk\",\"type\":\"uint256[20]\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[{\"internalType\":\"uint256[8]\",\"name\":\"proof\",\"type\":\"uint256[8]\"},{\"internalType\":\"uint256[2]\",\"name\":\"input\",\"type\":\"uint256[2]\"}],\"name\":\"verify\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"ok\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"verify(uint256[8],uint256[2])\":{\"params\":{\"input\":\"the public signals: [y, txHash]. `txHash` is the        transaction's `sig_hash` reduced mod R, which is what binds the        proof to this transaction's frames.\",\"proof\":\"a.x, a.y, b.x1, b.x0, b.y1, b.y0, c.x, c.y \\u2014 the exact        256-byte blob the frame transaction carries as its ARBITRARY        signature entry.\"},\"returns\":{\"ok\":\"true iff the pairing check holds.\"}}},\"title\":\"Groth16 verifier over BN254, callable from an EIP-8141 VERIFY frame. Two constraints shape this contract, both imposed by the validation-trace rules a VERIFY frame runs under during mempool simulation (ERC-7562 as adopted by EIP-8141, enforced in ethrex by `ValidationObserver`):  1. NO STORAGE. `SLOAD` is permitted during validation only when the storage     belongs to `tx.sender`; this contract is a separate account, so any     `SLOAD` here is a `StorageReadNonSender` violation and the transaction is     dropped from the mempool. The verifying key therefore lives in     immutables, which are burned into the contract's code.  2. NO `GAS` OPCODE, except immediately before a `*CALL`. That rules out the     `staticcall(sub(gas(), 2000), ...)` that snarkjs' exported verifier     emits: `GAS` followed by `SUB` trips the sequential-GAS rule. Every     precompile call below passes a literal gas figure instead. EIP-150 caps a     request larger than the available gas, so the literals are safe.\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"verify(uint256[8],uint256[2])\":{\"notice\":\"Verify a Groth16 proof.\"}},\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/Groth16Verifier.sol\":\"Groth16Verifier\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"src/Groth16Verifier.sol\":{\"keccak256\":\"0x25f31ffb5ddb64eb710e33d5e2450ae54cf72646963abfe2cdb517a5a9a3f039\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://8ad4e2ad0ff9079f175f689651be49453634d9334b52b047c509432edebfc393\",\"dweb:/ipfs/QmWAzQ8GgaSAoAuVa9H4WE1J7sR1Gqd2z1gVyT3dD4kkNC\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.30+commit.73712a01"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"uint256[20]","name":"vk","type":"uint256[20]"}],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[{"internalType":"uint256[8]","name":"proof","type":"uint256[8]"},{"internalType":"uint256[2]","name":"input","type":"uint256[2]"}],"stateMutability":"view","type":"function","name":"verify","outputs":[{"internalType":"bool","name":"ok","type":"bool"}]}],"devdoc":{"kind":"dev","methods":{"verify(uint256[8],uint256[2])":{"params":{"input":"the public signals: [y, txHash]. `txHash` is the        transaction's `sig_hash` reduced mod R, which is what binds the        proof to this transaction's frames.","proof":"a.x, a.y, b.x1, b.x0, b.y1, b.y0, c.x, c.y — the exact        256-byte blob the frame transaction carries as its ARBITRARY        signature entry."},"returns":{"ok":"true iff the pairing check holds."}}},"version":1},"userdoc":{"kind":"user","methods":{"verify(uint256[8],uint256[2])":{"notice":"Verify a Groth16 proof."}},"version":1}},"settings":{"remappings":[],"optimizer":{"enabled":true,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"src/Groth16Verifier.sol":"Groth16Verifier"},"evmVersion":"prague","libraries":{}},"sources":{"src/Groth16Verifier.sol":{"keccak256":"0x25f31ffb5ddb64eb710e33d5e2450ae54cf72646963abfe2cdb517a5a9a3f039","urls":["bzz-raw://8ad4e2ad0ff9079f175f689651be49453634d9334b52b047c509432edebfc393","dweb:/ipfs/QmWAzQ8GgaSAoAuVa9H4WE1J7sR1Gqd2z1gVyT3dD4kkNC"],"license":"MIT"}},"version":1},"id":0}