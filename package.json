{
  "name": "himitsu",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "test": "bun test packages",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test packages",
    "doctor": "bun scripts/doctor.ts",
    "build:paymaster": "bun build packages/contracts/src/paymaster.ts --target=node --format=esm --outfile=packages/protocol/generated/paymaster.mjs",
    "build:protocol": "bun run build:paymaster && bun run --cwd packages/protocol build:artifacts",
    "test:circuit": "bun run --cwd packages/protocol test:circuit",
    "test:lifecycle": "bun run --cwd packages/protocol test:lifecycle",
    "test:automatic": "bun run build:paymaster && bun run --cwd packages/protocol test:automatic",
    "test:attack": "bun run --cwd packages/protocol test:attack",
    "dev": "bun run --cwd app dev",
    "build:app": "bun run --cwd app build",
    "typecheck:app": "bun run --cwd app typecheck",
    "deploy:app": "bun run build:protocol && node packages/protocol/deploy-app.mjs",
    "test:surplus": "node packages/protocol/surplus.mjs",
    "test:client": "bun build scripts/test-client.ts --target=node --packages=external --outfile=.local/test-client.mjs && node .local/test-client.mjs",
    "setup:v2": "node packages/protocol/setup-v2.mjs",
    "deploy:app:v2": "node packages/protocol/compile-contracts.mjs && node packages/protocol/deploy-app-v2.mjs",
    "test:market": "bun build scripts/test-market.ts --target=node --packages=external --outfile=.local/test-market.mjs && node .local/test-market.mjs",
    "test:readiness": "bun scripts/test-readiness.ts",
    "test:v2-deposits": "bun scripts/test-v2-deposits.ts",
    "test:private-notes": "bun build scripts/test-private-notes.ts --target=node --packages=external --outfile=.local/test-private-notes.mjs && node .local/test-private-notes.mjs",
    "test:bidirectional": "bun build scripts/test-bidirectional.ts --target=node --packages=external --outfile=.local/test-bidirectional.mjs && node .local/test-bidirectional.mjs",
    "deploy:app:fixed": "node packages/protocol/compile-contracts.mjs && HIMITSU_POOL_MODE=fixed node packages/protocol/deploy-app-v2.mjs",
    "test:fixed": "bun build scripts/test-fixed.ts --target=node --packages=external --outfile=.local/test-fixed.mjs && node .local/test-fixed.mjs"
  },
  "dependencies": {
    "@scure/bip39": "1.6.0",
    "poseidon-lite": "0.3.0",
    "viem": "2.38.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.3.9",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
